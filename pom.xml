<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.drivesafe</groupId>
    <artifactId>drivesafe</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>DriveSafe</name>
    <description>Lightweight rental operations platform for independent agencies</description>

    <properties>
        <java.version>17</java.version>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <modules>
        <module>services/auth-service</module>
        <module>services/vehicle-service</module>
        <module>services/rental-service</module>
    </modules>
</project>
